<Window x:Class="ExcelMerge.GUI.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ExcelMerge"
        Icon="/ExcelMerge.GUI;component/app.ico"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        MinWidth="380"
        MaxHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" MaxHeight="180" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
        </ScrollViewer>

        <Expander x:Name="DetailExpander" Grid.Row="1" Header="详细信息" Margin="0,12,0,0">
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,6,0,0">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="11" Padding="6"/>
                </ScrollViewer>
            </Border>
        </Expander>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PrimaryButton" MinWidth="88" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="PrimaryButton_Click"/>
            <Button x:Name="CancelButton" MinWidth="88" Height="28"
                    IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
